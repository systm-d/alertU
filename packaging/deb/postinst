#!/bin/sh
set -e

case "$1" in
configure)
    # The service account and its input/video/audio groups. Shipped as a
    # sysusers.d fragment so systemd owns the definition; this just applies it
    # now instead of waiting for the next boot.
    if [ -x /usr/bin/systemd-sysusers ] || [ -x /bin/systemd-sysusers ]; then
        systemd-sysusers /usr/lib/sysusers.d/alertu.conf >/dev/null 2>&1 || true
    fi

    # No config file is shipped: anything under /etc would become a conffile,
    # and the daemon rewrites this one whenever the tray or the CLI saves
    # settings. It creates the file itself on first use; we only provide a
    # directory it is allowed to write to.
    mkdir -p /etc/alertu
    chown alertu:alertu /etc/alertu 2>/dev/null || true
    chmod 0755 /etc/alertu

    # Enable the tray for every account, present and future. `--global` writes
    # to /etc/systemd/user and applies to systemd user instances started after
    # this point, which is why it is a package-safe operation where touching a
    # running user instance would not be: this script has no business writing
    # into the instance of whoever happens to be logged in. Sessions already
    # open therefore pick it up at their next login.
    if [ -x /usr/bin/systemctl ] || [ -x /bin/systemctl ]; then
        systemctl --global enable alertu-gui.service >/dev/null 2>&1 || true
    fi

    if [ -x /usr/bin/gtk-update-icon-cache ]; then
        gtk-update-icon-cache -f -t /usr/share/icons/hicolor >/dev/null 2>&1 || true
    fi
    ;;
esac

#DEBHELPER#

# Guidance for a first-time install only ("$2" is the previously configured
# version, empty on a fresh install). Kept inside a `configure` arm so it
# cannot print on `postinst abort-remove`, and placed below the debhelper
# marker above so it is the last thing on screen, under dpkg's systemd chatter.
# Do not name that marker here: cargo-deb substitutes every occurrence of the
# literal token, including one inside a comment, which would splice generated
# code into the middle of this sentence and break the script.
case "$1" in
configure)
    if [ -z "$2" ]; then
        cat <<'EOF'

AlertU has been installed, its services are configured, and the tray is enabled
for every account.

Log out and back in. Two things only take effect in a new session: the tray
starts, and any group you were added to below applies.

Then finish in the interface, with no terminal:

  1. Open "AlertU — Settings" from your applications menu. If it says this
     account may not control AlertU, click "Authorize this account" — one
     password prompt. (The control socket is 0660 and group-owned, and no
     package may add an existing account to a group, so this is the one step
     that has to be a deliberate act. Log out and back in afterwards.)

  2. Click "Pair remote" in the tray menu or the settings window, then press a
     button on your remote. AlertU works out both the device and the key by
     itself — a key the remote cannot send is the classic reason a paired remote
     does nothing.

  3. If you want the siren audible, set the ALSA device in the settings window.
     The daemon has no user session of its own, so it cannot reach PipeWire or
     PulseAudio; `aplay -L` lists the devices, and the built-in speaker is the
     one that protects anything.

See /usr/share/doc/alertu/config.example.toml for every setting.

EOF
    fi
    ;;
esac

exit 0
