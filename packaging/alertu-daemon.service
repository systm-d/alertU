[Unit]
Description=AlertU privileged daemon (evdev remote guard)
Documentation=https://github.com/systm-d/alertu
After=systemd-logind.service
Wants=systemd-logind.service

[Service]
Type=simple
ExecStart=/usr/local/bin/alertu-daemon --config /etc/alertu/config.toml
Restart=on-failure
RestartSec=2

# The daemon needs to read input devices, capture from the webcam and play the
# siren. Running as a dedicated user in the input+video+audio groups is
# preferred over root; it also needs to talk to logind over the system bus and
# place its socket in /run.
#
# `audio` is what makes the alarm audible. /dev/snd/* is 0660 root:audio, and
# this user has no session of its own, so paplay/pw-play cannot reach a
# PipeWire/PulseAudio server and ALSA is the only route left — see the
# `alsa_device` setting and the module docs in src/sound.rs.
User=alertu
SupplementaryGroups=input video audio
RuntimeDirectory=alertu
RuntimeDirectoryMode=0750
StateDirectory=alertu
# Deliberately 0755, not 0750: the snapshot boundary lives one level down, on
# /var/lib/alertu/snapshots (0750, group-owned), and this directory must stay
# traversable so a --socket-group member can reach it.
StateDirectoryMode=0755

# Hardening (relax if it interferes with your setup).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# /etc/alertu is writable because `SetConfig` persists: the tray's device
# picker, the settings window and `alertu-ctl set-config` all save the config
# back. ProtectSystem=strict makes /etc read-only, so without this the daemon
# applies a new config live and then fails to write it — the change silently
# vanishes on restart. The directory must also be owned by `alertu`; see the
# README's install steps.
ReadWritePaths=/etc/alertu /var/lib/alertu
PrivateTmp=true

[Install]
WantedBy=multi-user.target
